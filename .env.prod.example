# Copy this file to .env in the same folder as docker-compose.prod.yml.
# Do not commit .env or paste its secret values into chat.

# RDS endpoint: hostname:3306 (without jdbc:mysql://)
AWS_DB_URL=
DB_NAME=roddy_db
AWS_DB_USERNAME=
AWS_DB_PASSWORD=

# Docker services
NEO4J_PASSWORD=
INTERNAL_API_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
RODDY_AI_IMAGE=ghcr.io/roddy-hongik/roddy_ai:latest

# OAuth credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# AWS
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=

# Backend secrets
JWT_SECRET_KEY=
TOKEN_SECRET_KEY=

# Public URLs; replace localhost before real users access the service.
APP_OAUTH2_REDIRECT_URI=
GITHUB_OAUTH_REDIRECT_URI=
GITHUB_FRONTEND_REDIRECT_URI=

# Optional
BE_PORT=8080
DDL_AUTO=validate
