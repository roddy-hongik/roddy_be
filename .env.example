# docker compose 가 읽는 값들. cp .env.example .env 후 채운다.

# 백엔드와 AI 서버가 나눠 갖는 비밀값. 아무 긴 문자열이면 된다.
#   openssl rand -hex 32
INTERNAL_API_SECRET=

# AI 분석 리포트 생성에 쓴다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 없어도 돌지만, 없으면 깃허브 공개 API 가 시간당 60회로 묶인다.
GITHUB_TOKEN=

# AI 서버 코드(roddy-hongik/roddy_ai) 클론 위치. 비워 두면 이 레포 옆의 ../roddy_ai 를 쓴다.
RODDY_AI_PATH=

# JWT 서명키. 기본값이 없어 반드시 채워야 한다.
JWT_SECRET_KEY=

# 기술 그래프(Neo4j) 비밀번호. 8자 이상이어야 한다.
NEO4J_PASSWORD=roddy-neo4j

DB_NAME=roddy
DB_PASSWORD=root
BE_PORT=8080

# 소셜 로그인과 깃허브 연동에 필요. 로컬에서 그 기능을 안 쓰면 비워 둬도 된다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

AWS_S3_BUCKET=roddy-dev-bucket
AWS_REGION=ap-northeast-2

# 실제 채용 사이트로 요청이 나간다. 켤 때만 true.
CRAWLER_SCHEDULER_ENABLED=false
